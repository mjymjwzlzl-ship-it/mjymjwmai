'use client';

import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { Star, TrendingUp, Eye, Heart, Users, BookOpen, LogOut, Plus, Edit, Trash2, Shield } from 'lucide-react';
import { categoryAPI, comicsAPI } from '@/lib/api-axios';

interface Webtoon {
  id: string;
  title: string;
  authorName: string;
  genre: string;
  thumbnail: string;
  viewCount: number;
  likeCount: number;
  status: string;
  createdAt: string;
  ageRating?: number | string; // 연령 등급 (숫자 또는 문자열)
}

export default function AdminDashboard() {
  const router = useRouter();
  const [webtoons, setWebtoons] = useState<Webtoon[]>([]);
  const [adultWebtoons, setAdultWebtoons] = useState<Webtoon[]>([]);
  const [loading, setLoading] = useState(true);
  const [mainTab, setMainTab] = useState<'general' | 'adult'>('general');
  const [subTab, setSubTab] = useState<'management' | 'statistics'>('management');
  const [selectedCategory, setSelectedCategory] = useState<'all' | 'popular' | 'editors' | 'new' | 'waitfree'>('all');
  const [refreshKey, setRefreshKey] = useState(0); // 강제 리렌더링용
  
  // 일반 웹툰 카테고리
  const [allWebtoons, setAllWebtoons] = useState<string[]>([]);
  const [popularWebtoons, setPopularWebtoons] = useState<string[]>([]);
  const [editorsWebtoons, setEditorsWebtoons] = useState<string[]>([]);
  const [newWebtoons, setNewWebtoons] = useState<string[]>([]);
  const [waitfreeWebtoons, setWaitfreeWebtoons] = useState<string[]>([]);
  
  // 성인 웹툰 카테고리
  const [adultAllWebtoons, setAdultAllWebtoons] = useState<string[]>([]);
  const [adultPopularWebtoons, setAdultPopularWebtoons] = useState<string[]>([]);
  const [adultEditorsWebtoons, setAdultEditorsWebtoons] = useState<string[]>([]);
  const [adultNewWebtoons, setAdultNewWebtoons] = useState<string[]>([]);
  const [adultWaitfreeWebtoons, setAdultWaitfreeWebtoons] = useState<string[]>([]);
  
  // 저장 상태 추적 (저장 후 일정 시간 동안 자동 로드 방지)
  const [lastSaveTime, setLastSaveTime] = useState<number>(0);

  useEffect(() => {
    // 클라이언트 사이드에서만 실행
    if (typeof window !== 'undefined') {
      checkAuth();
      fetchWebtoons();
      fetchAdultWebtoons();
      loadCategories(true); // 페이지 로드 시에는 항상 강제 로드
    }
  }, []);

  const checkAuth = () => {
    if (typeof window !== 'undefined') {
      const token = localStorage.getItem('adminToken');
      if (!token) {
        router.push('/login');
      }
    }
  };

  const fetchWebtoons = async () => {
    try {
      setLoading(true);
      
      // 백엔드에서 모든 웹툰 가져오기
      const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || '/api/proxy';
      
      const response = await fetch(`${API_BASE_URL}/admin/comics`, {
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('adminToken')}`,
          'Content-Type': 'application/json',
        }
      });
      
      
      if (response.ok) {
        const data = await response.json();
        
        // 일반 웹툰 필터링 (genre가 'adult'가 아닌 것들)
        const allComics = data.comics || [];
        const generalWebtoons = allComics.filter((comic: Webtoon) => {
          // genre 기준으로 필터링
          if (comic.genre === 'adult') return false;
          
          // ageRating이 있다면 추가 체크
          const rating = comic.ageRating || 0;
          const numericRating = typeof rating === 'string' ? parseInt(rating) : rating;
          return numericRating < 19; // 19세 미만은 일반 웹툰
        });
        
        setWebtoons(generalWebtoons);
      } else {
        // API 실패 시 테스트 데이터 사용
        const testWebtoons = [
          {
            id: '1',
            title: '테스트 웹툰 1',
            authorName: '테스트 작가1',
            genre: 'romance',
            viewCount: 1500,
            likeCount: 230,
            status: 'ongoing',
            createdAt: new Date().toISOString(),
            thumbnail: '/test-thumbnail1.jpg'
          },
          {
            id: '2', 
            title: '테스트 웹툰 2',
            authorName: '테스트 작가2',
            genre: 'action',
            viewCount: 2300,
            likeCount: 450,
            status: 'ongoing',
            createdAt: new Date().toISOString(),
            thumbnail: '/test-thumbnail2.jpg'
          }
        ];
        setWebtoons(testWebtoons);
      }
    } catch (error) {
      
      // 에러 발생 시 테스트 데이터 사용
      const testWebtoons = [
        {
          id: '1',
          title: '테스트 웹툰 1 (오프라인)',
          authorName: '테스트 작가1',
          genre: 'romance',
          viewCount: 1500,
          likeCount: 230,
          status: 'ongoing',
          createdAt: new Date().toISOString(),
          thumbnail: '/test-thumbnail1.jpg'
        }
      ];
      setWebtoons(testWebtoons);
    } finally {
      setLoading(false);
    }
  };

  const fetchAdultWebtoons = async () => {
    try {
      
      // 백엔드에서 성인 웹툰 가져오기
      const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || '/api/proxy';
      
      const response = await fetch(`${API_BASE_URL}/admin/comics/adult`, {
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('adminToken')}`,
          'Content-Type': 'application/json',
        }
      });
      
      
      if (response.ok) {
        const data = await response.json();
        // 성인 웹툰 필터링 (genre가 'adult'인 것들)
        const adultOnly = (data.comics || []).filter((webtoon: Webtoon) => {
          // genre 기준으로 필터링
          if (webtoon.genre === 'adult') return true;
          
          // ageRating이 있다면 추가 체크
          const rating = webtoon.ageRating || 0;
          const numericRating = typeof rating === 'string' ? parseInt(rating) : rating;
          return numericRating >= 19; // 19세 이상은 성인 웹툰
        });
        setAdultWebtoons(adultOnly);
      } else if (response.status === 404) {
        // 성인 전용 API가 없으면 일반 API에서 19+ 필터링
        const generalResponse = await fetch(`${API_BASE_URL}/admin/comics`, {
          headers: {
            'Authorization': `Bearer ${localStorage.getItem('adminToken')}`,
            'Content-Type': 'application/json',
          }
        });
        
        if (generalResponse.ok) {
          const generalData = await generalResponse.json();
          const adultOnly = (generalData.comics || []).filter((webtoon: Webtoon) => {
            // genre 기준으로 필터링
            if (webtoon.genre === 'adult') return true;
            
            // ageRating이 있다면 추가 체크
            const rating = webtoon.ageRating || 0;
            const numericRating = typeof rating === 'string' ? parseInt(rating) : rating;
            return numericRating >= 19; // 19세 이상은 성인 웹툰
          });
          setAdultWebtoons(adultOnly);
        } else {
          setAdultWebtoons([]);
        }
      } else {
        setAdultWebtoons([]);
      }
    } catch (error) {
      setAdultWebtoons([]);
    }
  };

  // localStorage 클리어 함수 제거 - 데이터 보존을 위해

  const loadCategories = async (forceLoad = false) => {
    // 브라우저 환경 체크 - 반드시 클라이언트에서만 실행
    if (typeof window === 'undefined') {
      console.log('서버 사이드 렌더링 중이므로 loadCategories 스킵');
      return;
    }
    
    // 토큰 체크
    const token = localStorage.getItem('adminToken');
    if (!token || token === 'null' || token === 'undefined') {
      console.log('토큰이 없어서 loadCategories 스킵');
      return;
    }
    
    // 강제 로드가 아닌 경우에만 최근 저장 체크 (페이지 새로고침 시에는 항상 로드)
    if (!forceLoad) {
      const timeSinceLastSave = Date.now() - lastSaveTime;
      if (timeSinceLastSave < 5000 && lastSaveTime > 0) { // 5초 이내 저장했으면 스킵
        console.log('최근 저장 후 5초 이내이므로 loadCategories 스킵');
        return;
      }
    }
    
    console.log('loadCategories 실행 중... (forceLoad:', forceLoad, ')');
    
    try {
      // 백엔드에서 카테고리 설정 가져오기
      console.log('일반 카테고리 로드 시작...');
      const backendCategories = await categoryAPI.getCategories();
      console.log('백엔드에서 카테고리 데이터 로드됨:', backendCategories);
      
      // 백엔드 데이터를 상태에 설정 (안전한 접근)
      const data = backendCategories?.data || backendCategories || {};
      setAllWebtoons(data.all || []);
      setPopularWebtoons(data.popular || []);
      setEditorsWebtoons(data.editors || []);
      setNewWebtoons(data.new || []);
      setWaitfreeWebtoons(data.waitfree || []);
      
      // 강제 리렌더링 트리거
      setRefreshKey(prev => prev + 1);
      console.log('일반 웹툰 카테고리 데이터 업데이트됨');
    } catch (error) {
      console.error('백엔드 연결 실패 상세 정보:', error);
      if (error instanceof Error) {
        console.error('에러 타입:', error.name);
        console.error('에러 메시지:', error.message);
      }
      
      // 더 자세한 에러 메시지 표시
      if (error instanceof Error) {
        alert(`백엔드 서버 연결 실패:\n${error.message}`);
      } else {
        alert('백엔드 서버 연결 실패');
      }
      
      // 백엔드 실패 시 빈 배열로 초기화
      setAllWebtoons([]);
      setPopularWebtoons([]);
      setEditorsWebtoons([]);
      setNewWebtoons([]);
      setWaitfreeWebtoons([]);
    }
    
    // 성인 웹툰 카테고리도 백엔드에서 가져오기
    try {
      console.log('성인 카테고리 로드 시작...');
      const adultCategories = await categoryAPI.getAdultCategories();
      console.log('백엔드에서 성인 카테고리 데이터 로드됨:', adultCategories);
      
      // 성인 웹툰 카테고리 업데이트 (안전한 접근)
      const adultData = adultCategories?.data || adultCategories || {};
      setAdultAllWebtoons(adultData.all || []);
      setAdultPopularWebtoons(adultData.popular || []);
      setAdultEditorsWebtoons(adultData.editors || []);
      setAdultNewWebtoons(adultData.new || []);
      setAdultWaitfreeWebtoons(adultData.waitfree || []);
      
      console.log('성인 웹툰 카테고리 데이터 업데이트됨');
    } catch (error) {
      console.error('성인 카테고리 백엔드 연결 실패:', error);
      
      // 백엔드 실패 시 빈 배열로 초기화
      setAdultAllWebtoons([]);
      setAdultPopularWebtoons([]);
      setAdultEditorsWebtoons([]);
      setAdultNewWebtoons([]);
      setAdultWaitfreeWebtoons([]);
    }
  };

  // localStorage 데이터를 백엔드로 이전하는 함수
  const migrateLocalStorageToBackend = async (popular: string[], editors: string[], newRecs: string[], waitfree: string[]) => {
    try {
      const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || '/api/proxy';
      const response = await fetch(`${API_BASE_URL}/admin/categories`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('adminToken')}`,
        },
        body: JSON.stringify({
          popular,
          editors,
          new: newRecs,
          waitfree
        })
      });
      
      if (response.ok) {
      }
    } catch (error) {
    }
  };

  const saveCategories = async () => {
    try {
      const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || '/api/proxy';
      
      if (mainTab === 'adult') {
        // 성인 웹툰 카테고리 저장
        await categoryAPI.saveAdultCategories({
          all: adultAllWebtoons,
          popular: adultPopularWebtoons,
          editors: adultEditorsWebtoons,
          new: adultNewWebtoons,
          waitfree: adultWaitfreeWebtoons
        });
        
        // 백엔드 저장 성공 - 상태 리셋 방지
        console.log('성인 웹툰 카테고리 저장 성공');
        
        // 저장 시간 기록 (자동 로드 방지용)
        setLastSaveTime(Date.now());
        
        alert('성인 웹툰 카테고리 설정이 저장되었습니다!\n\n' + 
              `전체: ${adultAllWebtoons.length}개\n` +
              `실시간 인기작: ${adultPopularWebtoons.length}개\n` +
              `에디터 추천: ${adultEditorsWebtoons.length}개\n` +
              `신작 추천: ${adultNewWebtoons.length}개\n` +
              `기다리면 무료: ${adultWaitfreeWebtoons.length}개`);
        
        // 프론트엔드 강제 갱신을 위한 이벤트 발생
        window.dispatchEvent(new CustomEvent('adultCategoryUpdated', {
          detail: { 
            popular: adultPopularWebtoons, 
            editors: adultEditorsWebtoons, 
            new: adultNewWebtoons, 
            waitfree: adultWaitfreeWebtoons,
            all: adultAllWebtoons,
            timestamp: new Date().toISOString()
          }
        }));
      } else {
        // 일반 웹툰 카테고리 저장
        await categoryAPI.saveCategories({
          all: allWebtoons,
          popular: popularWebtoons,
          editors: editorsWebtoons,
          new: newWebtoons,
          waitfree: waitfreeWebtoons
        });
        
        // 백엔드 저장 성공 - 상태 리셋 방지
        console.log('일반 웹툰 카테고리 저장 성공');
        
        // 저장 시간 기록 (자동 로드 방지용)
        setLastSaveTime(Date.now());
        
        alert('일반 웹툰 카테고리 설정이 저장되었습니다!\n\n' + 
              `전체: ${allWebtoons.length}개\n` +
              `실시간 인기작: ${popularWebtoons.length}개\n` +
              `에디터 추천: ${editorsWebtoons.length}개\n` +
              `신작 추천: ${newWebtoons.length}개\n` +
              `기다리면 무료: ${waitfreeWebtoons.length}개`);
        
        // 프론트엔드 강제 갱신을 위한 이벤트 발생
        window.dispatchEvent(new CustomEvent('categoryUpdated', {
          detail: { 
            popular: popularWebtoons, 
            editors: editorsWebtoons, 
            new: newWebtoons, 
            waitfree: waitfreeWebtoons,
            all: allWebtoons,
            timestamp: new Date().toISOString()
          }
        }));
        
        // localStorage를 통한 크로스 탭 알림
        localStorage.setItem('categoryUpdate', Date.now().toString());
        localStorage.removeItem('categoryUpdate');
        
        // 메인 사이트로 직접 이벤트 전송 (iframe이나 다른 창이 있는 경우)
        try {
          if (window.parent && window.parent !== window) {
            window.parent.postMessage({
              type: 'categoryUpdated',
              data: {
                popular: popularWebtoons,
                editors: editorsWebtoons,
                new: newWebtoons,
                waitfree: waitfreeWebtoons,
                all: allWebtoons,
                timestamp: new Date().toISOString()
              }
            }, '*');
          }
        } catch (e) {
          console.log('PostMessage 전송 불가:', e);
        }
      }
    } catch (error) {
      console.error('백엔드 저장 실패:', error);
      alert('백엔드 서버에 저장할 수 없습니다. 서버 상태를 확인해주세요.');
    }
  };

  const addToCategory = (webtoonId: string) => {
    // 성인/일반 탭에 따라 분기
    if (mainTab === 'adult') {
      // 성인 웹툰 카테고리
      if (selectedCategory === 'all') {
        if (!adultAllWebtoons.includes(webtoonId)) {
          setAdultAllWebtoons([...adultAllWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'popular') {
        if (!adultPopularWebtoons.includes(webtoonId)) {
          setAdultPopularWebtoons([...adultPopularWebtoons, webtoonId]);
        }
        // 다른 카테고리에 추가할 때도 all 배열에 자동 추가 (중복 방지)
        if (!adultAllWebtoons.includes(webtoonId)) {
          setAdultAllWebtoons([...adultAllWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'editors') {
        if (!adultEditorsWebtoons.includes(webtoonId)) {
          setAdultEditorsWebtoons([...adultEditorsWebtoons, webtoonId]);
        }
        if (!adultAllWebtoons.includes(webtoonId)) {
          setAdultAllWebtoons([...adultAllWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'new') {
        if (!adultNewWebtoons.includes(webtoonId)) {
          setAdultNewWebtoons([...adultNewWebtoons, webtoonId]);
        }
        if (!adultAllWebtoons.includes(webtoonId)) {
          setAdultAllWebtoons([...adultAllWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'waitfree') {
        if (!adultWaitfreeWebtoons.includes(webtoonId)) {
          setAdultWaitfreeWebtoons([...adultWaitfreeWebtoons, webtoonId]);
        }
        if (!adultAllWebtoons.includes(webtoonId)) {
          setAdultAllWebtoons([...adultAllWebtoons, webtoonId]);
        }
      }
    } else {
      // 일반 웹툰 카테고리
      if (selectedCategory === 'all') {
        if (!allWebtoons.includes(webtoonId)) {
          setAllWebtoons([...allWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'popular') {
        if (!popularWebtoons.includes(webtoonId)) {
          setPopularWebtoons([...popularWebtoons, webtoonId]);
        }
        // 다른 카테고리에 추가할 때도 all 배열에 자동 추가 (중복 방지)
        if (!allWebtoons.includes(webtoonId)) {
          setAllWebtoons([...allWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'editors') {
        if (!editorsWebtoons.includes(webtoonId)) {
          setEditorsWebtoons([...editorsWebtoons, webtoonId]);
        }
        if (!allWebtoons.includes(webtoonId)) {
          setAllWebtoons([...allWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'new') {
        if (!newWebtoons.includes(webtoonId)) {
          setNewWebtoons([...newWebtoons, webtoonId]);
        }
        if (!allWebtoons.includes(webtoonId)) {
          setAllWebtoons([...allWebtoons, webtoonId]);
        }
      } else if (selectedCategory === 'waitfree') {
        if (!waitfreeWebtoons.includes(webtoonId)) {
          setWaitfreeWebtoons([...waitfreeWebtoons, webtoonId]);
        }
        if (!allWebtoons.includes(webtoonId)) {
          setAllWebtoons([...allWebtoons, webtoonId]);
        }
      }
    }
  };

  const removeFromCategory = (webtoonId: string, index: number) => {
    // 성인/일반 탭에 따라 분기
    if (mainTab === 'adult') {
      // 성인 웹툰 카테고리
      if (selectedCategory === 'all') {
        const newAll = [...adultAllWebtoons];
        newAll.splice(index, 1);
        setAdultAllWebtoons(newAll);
      } else if (selectedCategory === 'popular') {
        const newPopular = [...adultPopularWebtoons];
        newPopular.splice(index, 1);
        setAdultPopularWebtoons(newPopular);
      } else if (selectedCategory === 'editors') {
        const newEditors = [...adultEditorsWebtoons];
        newEditors.splice(index, 1);
        setAdultEditorsWebtoons(newEditors);
      } else if (selectedCategory === 'new') {
        const newRecs = [...adultNewWebtoons];
        newRecs.splice(index, 1);
        setAdultNewWebtoons(newRecs);
      } else if (selectedCategory === 'waitfree') {
        const newWaitfree = [...adultWaitfreeWebtoons];
        newWaitfree.splice(index, 1);
        setAdultWaitfreeWebtoons(newWaitfree);
      }
    } else {
      // 일반 웹툰 카테고리
      if (selectedCategory === 'all') {
        const newAll = [...allWebtoons];
        newAll.splice(index, 1);
        setAllWebtoons(newAll);
      } else if (selectedCategory === 'popular') {
        const newPopular = [...popularWebtoons];
        newPopular.splice(index, 1);
        setPopularWebtoons(newPopular);
      } else if (selectedCategory === 'editors') {
        const newEditors = [...editorsWebtoons];
        newEditors.splice(index, 1);
        setEditorsWebtoons(newEditors);
      } else if (selectedCategory === 'new') {
        const newRecs = [...newWebtoons];
        newRecs.splice(index, 1);
        setNewWebtoons(newRecs);
      } else if (selectedCategory === 'waitfree') {
        const newWaitfree = [...waitfreeWebtoons];
        newWaitfree.splice(index, 1);
        setWaitfreeWebtoons(newWaitfree);
      }
    }
  };

  const getCurrentCategoryWebtoons = () => {
    let categoryIds: string[] = [];
    let targetWebtoons = mainTab === 'adult' ? adultWebtoons : webtoons;
    
    if (mainTab === 'adult') {
      // 성인 웹툰 카테고리
      if (selectedCategory === 'all') categoryIds = adultAllWebtoons;
      else if (selectedCategory === 'popular') categoryIds = adultPopularWebtoons;
      else if (selectedCategory === 'editors') categoryIds = adultEditorsWebtoons;
      else if (selectedCategory === 'new') categoryIds = adultNewWebtoons;
      else if (selectedCategory === 'waitfree') categoryIds = adultWaitfreeWebtoons;
    } else {
      // 일반 웹툰 카테고리
      if (selectedCategory === 'all') categoryIds = allWebtoons;
      else if (selectedCategory === 'popular') categoryIds = popularWebtoons;
      else if (selectedCategory === 'editors') categoryIds = editorsWebtoons;
      else if (selectedCategory === 'new') categoryIds = newWebtoons;
      else if (selectedCategory === 'waitfree') categoryIds = waitfreeWebtoons;
    }
    
    // 중복을 허용하기 위해 순서대로 매핑
    return categoryIds.map(id => targetWebtoons.find(webtoon => webtoon.id === id)).filter(Boolean);
  };

  const getAvailableWebtoons = () => {
    // 성인/일반 탭에 따라 해당하는 웹툰들만 반환
    return mainTab === 'adult' ? adultWebtoons : webtoons;
  };

  const handleLogout = () => {
    localStorage.removeItem('adminToken');
    localStorage.removeItem('adminUser');
    router.push('/login');
  };

  useEffect(() => {
    // localStorage 변경 감지 완전 제거 (자동 새로고침 방지)
    // 사용자가 카테고리를 변경하는 동안 방해받지 않도록 함
  }, []);

  const getCategoryTitle = () => {
    switch(selectedCategory) {
      case 'all': return '전체';
      case 'popular': return '실시간 인기작';
      case 'editors': return '에디터 추천';
      case 'new': return '1화만 보면 빠져든다';
      case 'waitfree': return '기다리면 무료';
      default: return '';
