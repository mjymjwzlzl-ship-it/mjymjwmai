// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 사용자 정보
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  nickname    String?  @unique // 표시되는 닉네임
  password    String?  // 소셜 로그인 시 null 가능
  avatar      String?
  role        String   @default("USER") // USER, ADMIN, CS_ADMIN
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  provider    String?  // google, kakao, email
  providerId  String?
  
  // 프로필 설정 관련
  needsProfileSetup Boolean @default(false) // 추가 프로필 설정 필요
  
  // 성인인증 관련
  adultVerified         Boolean   @default(false) // 성인인증 완료 여부
  adultVerifiedAt       DateTime? // 성인인증 완료 시간
  adultVerificationMethod String? // 인증 방법 (simple, pass, barocert)
  birthDate             String?   // 생년월일 (YYYY-MM-DD)
  birthYear             Int?      // 출생년도 (성인인증용)
  phoneNumber           String?   // 휴대폰 번호 (성인인증용)
  phoneVerified         Boolean   @default(false) // 휴대폰 인증 완료 여부
  phoneVerifiedAt       DateTime? // 휴대폰 인증 완료 시간
  
  // 코인 시스템 관련
  coinBalance           Int       @default(0) // 현재 코인 잔액

  // 챗봇 무료 메시지 카운트 (압축과 무관하게 유지)
  dailyMessageCount     Int       @default(0) // 오늘 보낸 메시지 수
  lastMessageDate       String?   // 마지막 메시지 날짜 (YYYY-MM-DD)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  comics      Comic[]
  comments    Comment[]
  reports     Report[]
  reportedBy  Report[]  @relation("ReportTarget")
  blockedUsers BlockedUser[] @relation("Blocker")
  blockedBy    BlockedUser[] @relation("Blocked")
  likes       Like[]
  views       View[]
  commentLikes CommentLike[]
  episodeLikes EpisodeLike[]
  episodeDislikes EpisodeDislike[]
  
  // 코인 시스템 관계
  coinTransactions CoinTransaction[]
  payments        Payment[]
  purchases       Purchase[]
  ratings         Rating[]
  comicRatings    ComicRating[]
  contentPurchases UserContentPurchase[]
  
  // 작가센터 관계
  author      Author?
  
  // 소설 관계
  novelLikes    NovelLike[]
  novelComments NovelComment[]
  
  // 커뮤니티 관계
  posts         Post[]
  postComments  PostComment[]
  postLikes     PostLike[]
  
  // 게임 관계
  gameScores    GameScore[]

  // 출석 체크 관계
  attendances   Attendance[]

  // 챗봇 메시지 관계
  chatMessages  ChatMessage[]

  @@map("users")
}

// 웹툰 작품 정보
model Comic {
  id          String     @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  genre       String     // JSON string으로 저장
  isPublished Boolean    @default(true) // soft-hide: 공개목록 노출여부
  isOfficial  Boolean    @default(false) // 정식연재 여부
  contentType String     @default("WEBTOON") // WEBTOON | BOOK(단행본) | NOVEL(웹소설)
  tags        String?    // 작품 태그(소재·키워드) JSON 배열 ["회귀","헌터"] — 장르와 별개
  credits     String?    // 참여자 JSON [{"role":"글","name":"홍길동"},{"role":"그림","name":"김철수"}] — 비면 authorName 을 나눠 씀 (lib/credits.js)
  status      String     @default("ONGOING") // ONGOING(연재중), HIATUS(휴재), COMPLETED(완결), SUSPENDED(판매중지: 새 구매 불가, 보유 회차는 열람), HIDDEN
  statusNotice String?   // 작품 상세 [공지사항] 탭 안내 (휴재 사유·판매중지 안내 등)
  resumeAt    DateTime?  // 휴재 작품 연재 재개 예정일
  rating      String     @default("all") // 연령 등급 (all, 12, 15, 19)
  authorName  String?    // 정식연재 작가명
  viewCount   Int        @default(0)
  likeCount   Int        @default(0)
  
  // 결제 관련 설정
  paidStartEpisode  Int    @default(1)  // 몇 화부터 유료인지 (1이면 전체 무료, 2면 2화부터 유료)
  episodeCoinPrice  Int    @default(3)  // 에피소드당 코인 가격
  rentalCoinPrice   Int?          // 대여 가격 (비우면 소장가-1, 최소 1)
  rentalDays        Int    @default(3) // 대여 기간(일)

  // 연재 요일 (mon, tue, wed, thu, fri, sat, sun)
  updateDays        String?  // JSON array로 저장 ["mon", "thu"] 형태

  // 다국어 지원
  locale            String   @default("ko") // ko(한국어), en(영어)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // 관계
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id])
  episodes    Episode[]
  comments    Comment[]
  likes       Like[]
  views       View[]
  reports     Report[]
  banners     Banner[]
  comicRatings ComicRating[]

  @@map("comics")
}

// 회차 정보
model Episode {
  id          String   @id @default(cuid())
  title       String   // 에피소드 제목 (줄거리)
  episodeNumber Int
  thumbnail   String?  // 에피소드 썸네일
  images      String   // JSON string으로 저장 (웹소설은 "[]")
  textContent String?  // 웹소설 회차 본문
  viewCount   Int      @default(0)
  rating      Float    @default(0)  // 평균 평점

  // 유료화 관련
  isFree      Boolean  @default(true) // 무료 회차 여부
  coinPrice   Int      @default(0) // 코인 가격 (0 = 무료)

  // 다국어 지원
  locale      String   @default("ko") // ko(한국어), en(영어)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  comicId     String
  comic       Comic    @relation(fields: [comicId], references: [id], onDelete: Cascade)
  comments    Comment[]
  views       View[]
  reports     Report[]  // 신고 관계 추가
  purchases   Purchase[] // 해당 에피소드 구매 내역
  ratings     Rating[]   // 평점들
  episodeLikes EpisodeLike[]
  episodeDislikes EpisodeDislike[]

  @@unique([comicId, episodeNumber])
  @@map("episodes")
}

// 댓글 정보
model Comment {
  id        String   @id @default(cuid())
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 대댓글 지원
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  // 관계
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comicId   String?
  comic     Comic?   @relation(fields: [comicId], references: [id])
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id])
  
  isSpoiler Boolean  @default(false) // 작성자가 [스포일러 포함] 켬 → 가려서 보여 준다
  hiddenAt  DateTime? // 관리자가 신고 처리로 숨김 (목록에서 빠짐)
  hiddenReason String?

  // 좋아요 관계
  commentLikes CommentLike[]
  reports      Report[]      // 신고 관계 추가

  @@map("comments")
}

// 댓글 좋아요 정보 (중복 방지용)
model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 관계
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

// 사용자 차단
model BlockedUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  reason    String?  // 차단 사유
  
  // 관계
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  
  @@unique([blockerId, blockedId]) // 중복 차단 방지
  @@map("blocked_users")
}

// 신고 정보
model Report {
  id          String     @id @default(cuid())
  type        String     // COMIC, EPISODE, COMMENT, USER
  reason      String     // INAPPROPRIATE, COPYRIGHT, SPAM, VIOLENCE, ADULT, OTHER
  description String?
  status      String     @default("PENDING") // PENDING(접수) → PROCESSING(확인 중) → RESOLVED(처리 완료) / REJECTED(반려)
  resolution  String?    // 처리 결과 메시지 (마지막 관리자 메모)
  imageUrl    String?    // 첨부 스크린샷 (backend/private/report-images, 관리자만 열람)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  resolvedAt  DateTime?  // 처리 완료 시간
  resolvedBy  String?    // 처리한 관리자 ID

  // 관계
  reporterId  String
  reporter    User       @relation(fields: [reporterId], references: [id])
  comicId     String?
  comic       Comic?     @relation(fields: [comicId], references: [id])
  episodeId   String?
  episode     Episode?   @relation(fields: [episodeId], references: [id])
  commentId   String?
  comment     Comment?   @relation(fields: [commentId], references: [id])
  targetUserId String?   // 신고 대상 사용자
  targetUser  User?      @relation("ReportTarget", fields: [targetUserId], references: [id])

  @@map("reports")
}

// 좋아요 정보
model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 관계
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comicId   String
  comic     Comic    @relation(fields: [comicId], references: [id])
  notify    Boolean  @default(true) // 이 작품 새 회차 알림 (작품별 on/off)

  @@unique([userId, comicId])
  @@map("likes")
}

// 에피소드 좋아요
model EpisodeLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 관계
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@map("episode_likes")
}

// 에피소드 싫어요
model EpisodeDislike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 관계
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@map("episode_dislikes")
}

// 조회수 정보
model View {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 관계
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  comicId   String?
  comic     Comic?   @relation(fields: [comicId], references: [id])
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id])

  @@map("views")
}

// 광고 관리
model AdConfig {
  id          String   @id @default(cuid())
  name        String
  position    String   // header, footer, native, interstitial
  code        String   // 광고 코드
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ad_configs")
}

// 코인 거래 내역
model CoinTransaction {
  id          String   @id @default(cuid())
  amount      Int      // 거래 코인 수량 (+ : 충전/지급, - : 사용/차감)
  balance     Int      // 거래 후 잔액
  type        String   // CHARGE(충전), PURCHASE(구매), REWARD(보상), REFUND(환불)
  description String   // 거래 설명
  createdAt   DateTime @default(now())

  // 관계
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  paymentId   String?  // 결제와 연결된 경우
  payment     Payment? @relation(fields: [paymentId], references: [id])

  @@map("coin_transactions")
}

// 결제 정보
model Payment {
  id              String   @id @default(cuid())
  impUid          String   @unique // 아임포트 결제 고유번호
  merchantUid     String   @unique // 가맹점 주문번호
  amount          Int      // 결제 금액 (원)
  coinAmount      Int      // 충전될 코인 수량
  bonusCoins      Int      @default(0) // 보너스 코인
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED, REFUNDED
  payMethod       String   // card, trans, vbank, phone, samsung, kpay, kakaopay, payco, lpay, ssgpay, tosspay, cultureland, smartculture, happymoney, booknlife, point
  pgProvider      String?  // PG사 (html5_inicis, kakaopay, tosspay 등)
  pgTid           String?  // PG사 거래번호
  buyerName       String?  // 구매자 이름
  buyerEmail      String?  // 구매자 이메일
  buyerTel        String?  // 구매자 전화번호
  failReason      String?  // 실패 사유
  receiptUrl      String?  // 영수증 URL
  refundAmount    Int?     // 환불 금액
  refundReason    String?  // 환불 사유
  refundedAt      DateTime? // 환불 일시
  completedAt     DateTime? // 결제 완료 일시
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 관계
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  coinTransactions CoinTransaction[]

  @@map("payments")
}

// 구매 내역 (에피소드)
model Purchase {
  id        String   @id @default(cuid())
  coinPrice Int      // 구매 시 사용한 코인 수량
  type      String   @default("OWN") // OWN(소장) | RENT(대여)
  expiresAt DateTime? // 대여 만료 시각 (소장은 null)
  createdAt DateTime @default(now())

  // 관계
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId]) // 중복 구매 방지
  @@map("purchases")
}

// 메인 배너 관리
model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  ctaText     String   // Call to Action 버튼 텍스트
  ctaLink     String   // 클릭 시 이동할 링크
  type        String   // event, best, serialized, adult 등
  order       Int      @default(0) // 표시 순서
  isActive    Boolean  @default(true)
  rating      Float?   // 별점
  ageRating   Int?     // 연령 제한
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  webtoonId   String?
  webtoon     Comic?   @relation(fields: [webtoonId], references: [id])

  @@map("banners")
}

// 평점 모델
model Rating {
  id        String   @id @default(cuid())
  score     Float    // 평점 (0.5 ~ 10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  // 유저별 에피소드당 하나의 평점만 가능
  @@unique([userId, episodeId])
  @@map("ratings")
}

// 작품 평점 (유저별 작품당 1개, 0.5 ~ 10)
model ComicRating {
  id        String   @id @default(cuid())
  score     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comicId   String
  comic     Comic    @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId])
  @@index([comicId])
  @@map("comic_ratings")
}

// 작가 정보 (작가센터 가입자)
model Author {
  id          String   @id @default(cuid())
  nickname    String   @unique
  bio         String?
  profileImage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 관계
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  novels      Novel[]  // 작가가 쓴 소설들
  
  @@map("authors")
}

// 소설 정보
model Novel {
  id          String   @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  genre       String   // fantasy, romance, martial, modern 등
  status      String   @default("ongoing") // ongoing, completed, hiatus
  isAdult     Boolean  @default(false)
  viewCount   Int      @default(0)
  isFeatured  Boolean  @default(false) // 추천 작품
  isBlocked   Boolean  @default(false) // 차단 여부
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 관계
  authorId    String
  author      Author   @relation(fields: [authorId], references: [id])
  chapters    Chapter[]
  likes       NovelLike[]
  comments    NovelComment[]
  
  @@map("novels")
}

// 소설 챕터
model Chapter {
  id           String   @id @default(cuid())
  title        String
  content      String   // 챕터 내용
  chapterNumber Int
  isFree       Boolean  @default(true)
  coinPrice    Int      @default(0)
  viewCount    Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // 관계
  novelId      String
  novel        Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  @@unique([novelId, chapterNumber])
  @@map("chapters")
}

// 소설 좋아요
model NovelLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  @@unique([userId, novelId])
  @@map("novel_likes")
}

// 소설 댓글
model NovelComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  @@map("novel_comments")
}

// 커뮤니티 게시글
model Post {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // general, webtoon, novel, review, free 등
  viewCount   Int      @default(0)
  upvotes     Int      @default(0)  // 추천수
  downvotes   Int      @default(0)  // 비추천수
  isPinned    Boolean  @default(false)
  isAdult     Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  comments    PostComment[]
  likes       PostLike[]
  
  @@map("posts")
}

// 게시글 댓글
model PostComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@map("post_comments")
}

// 게시글 좋아요
model PostLike {
  id        String   @id @default(cuid())
  isUpvote  Boolean  // true: 추천, false: 비추천
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([userId, postId])
  @@map("post_likes")
}

// 게임 점수 모델
model GameScore {
  id        String   @id @default(cuid())
  game      String   // tetris, snake, 2048 등
  score     Int      // 점수
  level     Int?     // 레벨 (게임에 따라 선택적)
  lines     Int?     // 라인 수 (테트리스용)
  data      String?  // 추가 데이터 (JSON)
  platform  String   @default("web") // web, mobile 구분
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([game, score]) // 게임별 점수 조회 최적화
  @@index([userId, game]) // 사용자별 게임 조회 최적화
  @@index([platform, game]) // 플랫폼별 게임 조회 최적화
  @@map("game_scores")
}

// 출석 체크 모델
model Attendance {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD 형식
  consecutiveDays Int      @default(1) // 연속 출석 일수
  reward          Int      // 받은 보상 코인
  createdAt       DateTime @default(now())

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, date]) // 하루에 한 번만 출석 가능
  @@index([userId, date]) // 사용자별 출석 조회 최적화
  @@map("attendances")
}

// 챗봇 메시지 모델
model ChatMessage {
  id          String   @id @default(cuid())
  role        String   // user, assistant
  content     String   // 메시지 내용
  imageUrl    String?  // 생성된 이미지 URL
  audioUrl    String?  // 생성된 음성 URL
  comicId     String   // 웹툰 ID
  characterId String   // 캐릭터 ID
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, comicId, characterId]) // 사용자별 대화 조회 최적화
  @@index([createdAt]) // 시간순 정렬 최적화
  @@map("chat_messages")
}

// SQLite는 enum을 지원하지 않으므로 String으로 대체
// UserRole: USER, ADMIN, CS_ADMIN
// UserStatus: ACTIVE, SUSPENDED, BANNED
// ComicStatus: ONGOING, COMPLETED, HIATUS
// ReportStatus: PENDING, RESOLVED, REJECTED
// TransactionType: CHARGE, PURCHASE, REWARD, REFUND
// PaymentStatus: PENDING, PAID, FAILED, CANCELLED, REFUNDED


// 화보(PHOTOBOOK) 등 작품 부가 콘텐츠와 코인 구매 기록 — 제용 개발분 중 화보에 필요한 부분만 (2026-09-29)
model UserContentPurchase {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String // EXTRA, PHOTOBOOK
  coinAmount  Int
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId, purchasedAt])
  @@map("user_content_purchases")
}

model ContentItem {
  id                    String    @id @default(cuid())
  workId                String?
  characterId           String?
  photobookId           String?   @unique
  name                  String
  thumbnail             String?
  assetCount            Int       @default(0)
  previewCount          Int       @default(0)
  contentType           String // PHOTOBOOK, CHATBOT
  contentRating         String    @default("GENERAL")
  accessType            String    @default("COIN")
  requiredPlan          String?
  coinPrice             Int       @default(0)
  isFree                Boolean   @default(false)
  isActive              Boolean   @default(true)
  releaseAt             DateTime?
  assets                String? // JSON string
  isSponsored           Boolean   @default(false)
  sponsorName           String?
  sponsorshipDisclosure String?
  campaignId            String?
  productTags           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([workId, contentType, isActive])
  @@index([characterId, contentType, isActive])
  @@map("content_items")
}

// 이벤트 (홈 이벤트 코너·/events 페이지). 상태는 기간으로 계산: 예정(startAt 전) · 진행 중 · 종료(endAt 지남)
model Event {
  id           String    @id @default(cuid())
  title        String
  summary      String?
  thumbnailUrl String    // 목록 카드 이미지 (16:9 권장)
  link         String    // 누르면 이동할 곳 (/attendance, /subscribe 등)
  startAt      DateTime
  endAt        DateTime? // 비우면 상시 진행
  isActive     Boolean   @default(true) // 끄면 어디에도 노출 안 함
  isFeatured   Boolean   @default(false) // 홈 이벤트 코너에 우선 노출
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, startAt])
  @@map("events")
}

// 작품 프로모션 (할인·무료). 기간 안에서만 적용되고, 끝나면 목록·가격에서 자동으로 빠진다.
// DISCOUNT: 유료 회차 대여·소장가 value% 할인 / FREE_EPISODES: 1~value화 무료 / FREE_RENTAL: 유료 회차 무료 대여
model ComicPromotion {
  id        String    @id @default(cuid())
  comicId   String
  type      String    // DISCOUNT | FREE_EPISODES | FREE_RENTAL
  value     Int       @default(0)
  title     String?   // 목록에 보일 짧은 문구 (비우면 자동)
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([comicId, isActive])
  @@map("comic_promotions")
}

// 알림함. 알림을 볼 때(목록·안 읽은 수 조회) 그 사용자 것만 만들어 둔다 (services/notifications.js)
// type: UPDATE(찜한 작품 새 회차) | EVENT(이벤트 시작·종료 임박) | PROMOTION(할인·무료)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  imageUrl  String?
  dedupeKey String   // 같은 소식을 두 번 만들지 않기 위한 키
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// 알림 종류별 on/off + 마지막으로 새 소식을 확인한 시각
model NotificationPreference {
  userId     String   @id
  updates    Boolean  @default(true)
  events     Boolean  @default(true)
  promotions Boolean  @default(true)
  syncedAt   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notification_preferences")
}

// 작품 공지 (작품 상세 [작품 공지] 탭). type: HIATUS(휴재 안내) | RESUME(연재 재개) | SCHEDULE(업로드 일정 변경) | SUSPENDED(판매중지 안내) | GENERAL(공지)
model ComicNotice {
  id        String   @id @default(cuid())
  comicId   String
  type      String   @default("GENERAL")
  title     String
  content   String
  isPinned  Boolean  @default(false) // 상단 고정 (목록 맨 위)
  isImportant Boolean @default(false) // [중요] 배지
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([comicId, isPinned, createdAt])
  @@map("comic_notices")
}

// 이벤트(무료) 코인 지급 건. User.coinBalance 는 여전히 보유 코인 합계이고,
// 이벤트 코인 = 남은 remaining 합계, 유료 코인 = 합계 - 이벤트 코인. 쓸 때는 만료가 빠른 이벤트 코인부터 (services/coin-wallet.js)
model EventCoinGrant {
  id        String    @id @default(cuid())
  userId    String
  amount    Int
  remaining Int
  reason    String
  source    String    @default("EVENT") // ATTENDANCE | GIFT | ADMIN | EVENT
  expiresAt DateTime? // 비우면 기한 없음
  createdAt DateTime  @default(now())

  @@index([userId, remaining, expiresAt])
  @@map("event_coin_grants")
}

// 쿠폰·이용권 종류. type: DISCOUNT(value% 할인) | RENT_PASS(회차 무료 대여) | OWN_PASS(회차 무료 소장)
model Coupon {
  id             String    @id @default(cuid())
  name           String
  type           String
  value          Int       @default(0)
  comicId        String?   // 비우면 모든 작품
  code           String?   @unique // 쿠폰 번호 (등록형)
  uses           Int       @default(1) // 한 사람이 쓸 수 있는 횟수(이용권 장수)
  validDays      Int?      // 받은 날부터 N일
  expiresAt      DateTime? // 절대 만료일 (둘 다 있으면 빠른 쪽)
  maxRedemptions Int?      // 쿠폰 번호 총 등록 가능 수
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("coupons")
}

model UserCoupon {
  id            String    @id @default(cuid())
  userId        String
  couponId      String
  remainingUses Int
  expiresAt     DateTime?
  source        String    @default("GIFT") // CODE | GIFT | ADMIN
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, remainingUses])
  @@map("user_coupons")
}

// 선물함: 받기 전까지는 보유 항목에 들어가지 않는다. type: COIN | COUPON
model Gift {
  id           String    @id @default(cuid())
  userId       String
  type         String
  amount       Int       @default(0) // COIN: 코인 수
  coinValidDays Int?     // COIN: 받은 뒤 이벤트 코인 유효기간(일), 비우면 기한 없음
  couponId     String?   // COUPON
  reason       String
  claimBefore  DateTime? // 이때까지 받아야 함
  claimedAt    DateTime?
  batchId      String?   // 관리자 한 번 발송 묶음
  createdAt    DateTime  @default(now())

  @@index([userId, claimedAt])
  @@map("gifts")
}

// 내 서재 목록에서 숨긴 작품 (열람한 작품·구매 작품). 구매·소장·대여 내역은 그대로, 목록에서만 뺀다.
// hiddenAt 이후 다시 보거나 새로 구매하면 목록에 다시 나타난다. 찜한 작품 삭제는 찜 해제(Like 삭제)라 여기 쓰지 않음.
model LibraryHide {
  id        String   @id @default(cuid())
  userId    String
  comicId   String
  section   String   // viewed | purchased
  hiddenAt  DateTime @default(now())

  @@unique([userId, comicId, section])
  @@index([userId, section])
  @@map("library_hides")
}

// 신고 처리 이력: 상태가 바뀔 때마다 한 줄 (누가·언제·무엇으로·메모). 같은 대상 신고가 반복될 때 지난 처리를 본다.
model ReportHistory {
  id         String   @id @default(cuid())
  reportId   String
  fromStatus String?
  toStatus   String
  memo       String?
  adminId    String?
  adminName  String?
  createdAt  DateTime @default(now())

  @@index([reportId, createdAt])
  @@map("report_histories")
}
